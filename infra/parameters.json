{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "westus2"
    },
    "imageTag": {
      "value": "latest"
    },
    "googleClientId": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/SUBSCRIPTION_ID/resourceGroups/rg-hhm-prod/providers/Microsoft.KeyVault/vaults/kv-hhm-prod"
        },
        "secretName": "google-client-id"
      }
    },
    "googleClientSecret": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/SUBSCRIPTION_ID/resourceGroups/rg-hhm-prod/providers/Microsoft.KeyVault/vaults/kv-hhm-prod"
        },
        "secretName": "google-client-secret"
      }
    },
    "sessionSecretKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/SUBSCRIPTION_ID/resourceGroups/rg-hhm-prod/providers/Microsoft.KeyVault/vaults/kv-hhm-prod"
        },
        "secretName": "session-secret-key"
      }
    }
  }
}
