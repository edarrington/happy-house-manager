# ============================================================
# Happy House Manager - Environment Variables
# Copy this file to .env and fill in real values.
# This is the ONLY .env needed (no separate frontend/.env).
# ============================================================

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Session / JWT Secret ---
# Use a long random string: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Azure Cosmos DB ---
COSMOS_ENDPOINT=https://cosmos-hhm-prod.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE_NAME=happy-house-manager
COSMOS_USERS_CONTAINER=users

# --- Azure Key Vault ---
KEY_VAULT_URL=https://kv-hhm-prod.vault.azure.net/
# For local dev without managed identity:
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# --- App ---
APP_BASE_URL=http://localhost:8000
ENVIRONMENT=development

# --- Todoist (per-user tokens stored in Cosmos DB after first login + linking) ---
# Only needed for initial bootstrap/testing
TODOIST_API_TOKEN_ERICK=your-erick-todoist-token
TODOIST_API_TOKEN_JEWEL=your-jewel-todoist-token
